# Copy to .env and fill in. docker compose reads this file automatically.
# NGROK_AUTHTOKEN is required — get it at https://dashboard.ngrok.com
NGROK_AUTHTOKEN=

# Optional — JobPilot will run with built-in fallbacks if left empty:
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-pro
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# JOOBLE_API_KEY=
# INDEED_CLIENT_ID=
# INDEED_CLIENT_SECRET=
# INDEED_ACCESS_TOKEN=
# APIFY_API_TOKEN=
