# Supabase (see supabase/schema.sql for the one-time migration)
SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Optional: enables job ingestion to bypass RLS. Leave empty to use the
# authenticated-write policies in supabase/schema.sql instead.
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# DeepSeek (reusing the harness key)
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# Optional job-provider API keys. The app already fetches live jobs from the free
# no-key public APIs (Remotive, Arbeitnow, Jobicy, The Muse). Adding these keys
# brings in aggregated listings (including LinkedIn-sourced posts).
ADZUNA_APP_ID=YOUR_ADZUNA_APP_ID
ADZUNA_APP_KEY=YOUR_ADZUNA_APP_KEY
JOOBLE_API_KEY=YOUR_JOOBLE_API_KEY

# Optional: board-native Indeed postings via Indeed's GraphQL API. Requires an
# Indeed partner app with the job-retrieval-service entitlement.
INDEED_CLIENT_ID=YOUR_INDEED_CLIENT_ID
INDEED_CLIENT_SECRET=YOUR_INDEED_CLIENT_SECRET
INDEED_ACCESS_TOKEN=YOUR_INDEED_ACCESS_TOKEN

# Optional: Apify API token. Enables the misceres/indeed-scraper actor as a
# second Indeed source (up to 50 results per CV submission).
APIFY_API_TOKEN=YOUR_APIFY_API_TOKEN
# Optional: override the Apify actor id (defaults to misceres/indeed-scraper)
# APIFY_INDEED_ACTOR_ID=misceres/indeed-scraper
